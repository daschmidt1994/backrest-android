<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView style="@style/FieldLabel" android:text="@string/server_url" />
        <EditText
            android:id="@+id/input_url"
            style="@style/Field"
            android:hint="@string/server_url_hint"
            android:inputType="textUri" />

        <TextView style="@style/FieldLabel" android:text="@string/username" />
        <EditText
            android:id="@+id/input_user"
            style="@style/Field"
            android:autofillHints="username"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="@string/password" />
        <EditText
            android:id="@+id/input_password"
            style="@style/Field"
            android:autofillHints="password"
            android:inputType="textPassword" />

        <TextView style="@style/FieldLabel" android:text="@string/interval" />
        <EditText
            android:id="@+id/input_interval"
            style="@style/Field"
            android:inputType="number" />

        <Switch
            android:id="@+id/input_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notify"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save" />

        <TextView
            android:id="@+id/result"
            style="@style/Secondary"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
